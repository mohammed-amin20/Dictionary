<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Open book -->
    <path
        android:pathData="M54,60 C46,56 32,56 22,62 L22,84 C32,80 46,80 54,86 C62,80 76,80 86,84 L86,62 C76,56 62,56 54,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="22"
                android:startY="56"
                android:endX="86"
                android:endY="86">
                <item
                    android:color="#FF8FE0E4"
                    android:offset="0.0" />
                <item
                    android:color="#FF3E9EA3"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Spine -->
    <path
        android:pathData="M54,60 L54,86"
        android:strokeColor="#59003738"
        android:strokeWidth="2"
        android:strokeLineCap="round" />

    <!-- Magnifier lens -->
    <path
        android:pathData="M54,21 a21,21 0 1,0 0.01,0 Z"
        android:fillColor="#CC0F1615"
        android:strokeColor="#FF7FD3D7"
        android:strokeWidth="7" />

    <!-- Lens highlight -->
    <path
        android:pathData="M43,33 a15,15 0 0,1 10,-7"
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round" />

    <!-- Handle -->
    <path
        android:pathData="M69,57 L87,75"
        android:strokeWidth="9"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="69"
                android:startY="57"
                android:endX="87"
                android:endY="75">
                <item
                    android:color="#FFE7C36B"
                    android:offset="0.0" />
                <item
                    android:color="#FFC89A32"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
